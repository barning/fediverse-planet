{
	"name": "fediverse-planet",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "pnpm validate:data && vite dev",
		"build": "pnpm validate:data && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && tsx scripts/validate.ts",
		"check": "pnpm validate:data && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run && node --test tests/state-git.test.mjs",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:e2e": "playwright test",
		"collect": "tsx scripts/collect.ts",
		"validate:data": "tsx scripts/validate.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/sanitize-html": "^2.16.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@11.25.0",
	"dependencies": {
		"@lucide/svelte": "^1.59.0",
		"clsx": "^2.1.1",
		"ipaddr.js": "^2.5.0",
		"rss-parser": "^3.13.0",
		"sanitize-html": "^2.18.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"undici": "^8.12.2",
		"zod": "^4.6.7"
	},
	"engines": {
		"node": ">=24.0.0 <25"
	}
}
